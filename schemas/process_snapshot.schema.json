{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProcessSnapshot",
  "type": "object",
    "required": [
    "snapshot_id",
    "asset_id",
    "captured_at",
    "source_timestamp",
    "features"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the backend froze this immutable Snapshot."
    },
    "source_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "OPC UA / measurement time copied from the Digital Twin."
    },
    "ingest_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the backend ingested the live Twin state used for this Snapshot."
    },
    "source_state_version": {
      "type": "string"
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reduction_ratio",
        "die_half_angle_rad",
        "friction_coefficient",
        "normalized_hardening_coefficient"
      ],
      "properties": {
        "reduction_ratio": {
          "type": "number"
        },
        "die_half_angle_rad": {
          "type": "number"
        },
        "friction_coefficient": {
          "type": "number"
        },
        "normalized_hardening_coefficient": {
          "type": "number"
        }
      }
    }
  }
}
