#usda 1.0
(
    defaultPrim = "Looks"
    metersPerUnit = 1
    upAxis = "Z"
    doc = "Restrained industrial preview materials. Conceptual display only."
)

def Scope "Looks"
{
    def Material "MAT_FactoryFloor"
    {
        token outputs:surface.connect = </Looks/MAT_FactoryFloor/Preview.outputs:surface>
        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.07, 0.07, 0.068)
            float inputs:metallic = 0.0
            float inputs:roughness = 0.82
            token outputs:surface
        }
    }
