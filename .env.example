# Development-only defaults. Do not use these values on a mill network.

APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL / TimescaleDB (development-only credentials)
POSTGRES_USER=cold_drawing
POSTGRES_PASSWORD=dev-only-not-production
POSTGRES_DB=cold_drawing
DATABASE_URL=postgresql+psycopg://cold_drawing:dev-only-not-production@localhost:5432/cold_drawing

# RabbitMQ / Celery (development-only broker)
RABBITMQ_DEFAULT_USER=cold_drawing
RABBITMQ_DEFAULT_PASS=dev-only-not-production
CELERY_BROKER_URL=amqp://cold_drawing:dev-only-not-production@localhost:5672//
CELERY_RESULT_BACKEND=rpc://
FEA_EXECUTION=inline

# Eclipse BaSyx
BASYX_AAS_REPOSITORY_URL=http://localhost:8081
BASYX_ENABLED=false

# PINN
PINN_HF_REPO=MongsangGa/cold-drawing-pinn-poc
PINN_MODEL_VERSION=v0.1.1
PINN_MODEL_DIR=./models/cold-drawing-pinn-poc

# OpenRadioss
OPENRADIOSS_STARTER_BIN=
OPENRADIOSS_ENGINE_BIN=
OPENRADIOSS_WORK_DIR=./simulation/workspaces
FEA_JOB_TIMEOUT_S=600

# Omniverse / OpenUSD
USD_STAGE_PATH=./usd/factory/bugok_factory.usda

# OPC UA
OPCUA_ENDPOINT=opc.tcp://127.0.0.1:4840/cold-drawing/
